PORT=3000
SITE_URL=http://localhost:3000
# Required in production. Development starts a local MongoDB replica set if omitted.
MONGODB_URI=
MONGODB_DATABASE=aurelio
LOCAL_MONGO_PORT=63938
# Generate a long random value (32+ characters) for production admin authentication.
ADMIN_TOKEN=
HOST=127.0.0.1
# Never enable the studio's local email inbox on a public deployment.
LOCAL_EMAIL_PREVIEW=false
# Remains false until launch gates and approved content are complete.
INDEXING_ENABLED=false

# The retail shop runs on Shopify: set its address in app/lib/brand.ts (shopUrl).

# --- Email (Amazon SES) ---
AWS_REGION=ap-south-1
# ses | local (development inbox) | none
EMAIL_PROVIDER=local
# A sender on a domain verified in SES, e.g. "Aurelio <orders@yourdomain.in>"
EMAIL_FROM=
# Where the studio receives enquiries and order alerts.
NOTIFY_EMAIL=mohdsaudsaud595@gmail.com

# --- Hosting ---
# Set to 1 when running behind a load balancer (the Dockerfile does).
TRUST_PROXY=
