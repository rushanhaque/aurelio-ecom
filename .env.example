PORT=3000
SITE_URL=http://localhost:3000
# Required in production. Development starts a local MongoDB replica set if omitted.
MONGODB_URI=
MONGODB_DATABASE=aurelio
LOCAL_MONGO_PORT=63938
# Generate a long random value for production admin authentication.
ADMIN_TOKEN=
# Preview orders are unpaid simulations, never real payment confirmations.
ALLOW_PREVIEW_ORDERS=false
HOST=127.0.0.1
# Never enable the local account-link inbox on a public deployment.
LOCAL_EMAIL_PREVIEW=false
# Remains false until launch gates and approved content are complete.
INDEXING_ENABLED=false
